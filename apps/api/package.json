{
  "name": "@shop/api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "migrate:v2": "tsx src/migrate-v2.ts",
    "test": "vitest run --pool=forks --poolOptions.forks.minForks=1 --poolOptions.forks.maxForks=2"
  },
  "dependencies": {
    "@shop/shared": "*",
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.9.0",
    "multer": "^2.0.0",
    "sharp": "^0.35.3",
    "stripe": "^18.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
