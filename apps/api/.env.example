# Port the API listens on locally. Render sets this itself in production.
PORT=3001

# MongoDB connection string (Atlas SRV URI in production, local/in-memory Mongo in dev).
MONGO_URL=mongodb+srv://user:password@cluster0.mongodb.net/handmade-portfolio

# Stripe secret key, test mode until go-live.
STRIPE_SECRET_KEY=sk_test_dummy

# Stripe webhook signing secret, from the webhook endpoint created in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_dummy

# Secret used to sign admin auth JWTs. Render generates this automatically via render.yaml.
JWT_SECRET=dummy-jwt-secret

# Admin login email.
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the admin password (never the plaintext password itself).
ADMIN_PASSWORD_HASH=$2a$10$dummydummydummydummyudummydummydummydummydummydu

# Origin the API's CORS policy allows (the deployed storefront's URL).
WEB_ORIGIN=https://shop.augustoamaral.com

# Cloudflare account ID, used for the R2 S3-compatible client.
R2_ACCOUNT_ID=dummy-account-id

# R2 API token access key ID.
R2_ACCESS_KEY_ID=dummy-access-key-id

# R2 API token secret access key.
R2_SECRET_ACCESS_KEY=dummy-secret-access-key

# R2 bucket name product photos are uploaded to.
R2_BUCKET=handmade-portfolio

# Public URL photos are served from (R2 bucket's custom domain).
R2_PUBLIC_URL=https://img.shop.augustoamaral.com
